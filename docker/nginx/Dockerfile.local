FROM node:22-bookworm-slim AS build
WORKDIR /web
RUN corepack enable
COPY frontend/web/package.json frontend/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/web/ .
# API 走同源 /api/v1；留空的 WS 地址由页面所在源站推导。
ENV VITE_API_BASE_URL=http://127.0.0.1:8001 VITE_APP_WS_ENDPOINT=""
RUN pnpm run build

FROM nginx:stable-alpine
COPY LICENSE /usr/share/nginx/html/LICENSE
COPY docker/nginx/local.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html/web
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/web/ || exit 1
